# Base de datos
DATABASE_URL=postgresql+psycopg://studyforge_app:password@localhost:5432/studyforge?options=-csearch_path=studyforge,public

# JWT y seguridad (¡CAMBIAR EN PRODUCCIÓN!)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Upload de archivos
MAX_FILE_SIZE_MB=10

# Entorno
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Logging a archivos
LOG_TO_FILE=True
LOG_FILE_PATH=logs/studyforge.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# SQL Logging (queries de base de datos)
LOG_SQL_QUERIES=False
LOG_SQL_LEVEL=INFO
LOG_SQL_TO_SEPARATE_FILE=False
LOG_SQL_FILE_PATH=logs/sql.log
